# Database Connection (PostgreSQL)
# For local development, install PostgreSQL or launch via Docker:
# docker run --name eventcraft-postgres -e POSTGRES_PASSWORD=password -e POSTGRES_DB=eventcraft_dev -p 5432:5432 -d postgres:16
DATABASE_URL="postgresql://postgres:password@localhost:5432/eventcraft_dev?schema=public"

# Authentication (Secure 32+ character random string for signing JWT session tokens)
AUTH_SECRET="eventcraft-ai-super-secret-key-32-chars-minimum-token-protection"
NEXTAUTH_URL="http://localhost:3000"

# Application Settings
APP_ENV="development"
APP_URL="http://localhost:3000"

# AI Planning Engine Configuration (Server-Side Only - Phase 5)
# Supported options for AI_PROVIDER: "gemini" | "openai" (falls back automatically to curated domain templates if empty or unconfigured)
AI_PROVIDER="gemini"
AI_TIMEOUT_MS="15000"

# Google Gemini API Configuration
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-pro"

# OpenAI API Configuration
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"

