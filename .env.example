# ========================================================
# EventCraft AI — Environment Configuration
# ========================================================
# EventCraft AI runs 100% locally in your web browser.
# All persistence is handled by native IndexedDB (eventcraft_local_db).
# All planning algorithms, budgeting, and command interpretation run locally.
# Zero external databases (PostgreSQL/Prisma) or cloud intelligence services are required.

# Application Configuration
NEXT_PUBLIC_APP_NAME="EventCraft AI"
NEXT_PUBLIC_APP_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
