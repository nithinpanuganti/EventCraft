datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// Enums
// -------------------------------------------------------------

enum EventType {
  WEDDING
  BIRTHDAY
  COMMUNITY
}

enum EventStatus {
  DRAFT
  PLANNING
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum TaskPhase {
  PLANNING
  BOOKING
  PREPARATION
  EVENT_DAY
  POST_EVENT
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  COMPLETED
  CANCELLED
}

enum VendorStatus {
  RESEARCHING
  CONTACTED
  QUOTED
  BOOKED
  DECLINED
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
}

enum RsvpStatus {
  INVITED
  CONFIRMED
  DECLINED
  TENTATIVE
}

// -------------------------------------------------------------
// Models
// -------------------------------------------------------------

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Tenant ownership: User owns Events
  events       Event[]

  @@map("users")
}

model Event {
  id          String      @id @default(cuid())
  userId      String
  title       String
  type        EventType
  eventDate   DateTime?
  location    String?
  guestCount  Int         @default(1)
  totalBudget Decimal     @default(0.00) @db.Decimal(12, 2)
  currency    String      @default("USD")
  status      EventStatus @default(DRAFT)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // Owner relationship
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Child relationships (1:1 and 1:N)
  preferences      EventPreferences?
  plan             EventPlan?
  budgetCategories BudgetCategory[]
  tasks            Task[]
  vendors          Vendor[]
  guests           Guest[]
  revisions        PlanRevision[]

  @@index([userId])
  @@index([status])
  @@map("events")
}

model EventPreferences {
  id                        String   @id @default(cuid())
  eventId                   String   @unique
  themeDescription          String?
  colorPalette              String?
  dietaryRestrictions      String?
  accessibilityRequirements String?
  additionalNotes           Json?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("event_preferences")
}

model EventPlan {
  id                String   @id @default(cuid())
  eventId           String   @unique
  conceptTitle      String
  conceptNarrative  String   @db.Text
  dayOfSchedule     Json?    // Array of { time, activity, lead, notes }
  aiRecommendations Json?    // Structured recommendations & tips
  version           Int      @default(1)
  generatedAt       DateTime @default(now())
  updatedAt         DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("event_plans")
}

model PlanRevision {
  id            String   @id @default(cuid())
  eventId       String
  version       Int
  userPrompt    String   @db.Text
  intent        String   // e.g. "BUDGET_REDUCTION", "THEME_ADJUSTMENT", "TIMELINE_SHIFT"
  changeSummary String   @db.Text
  diffPayload   Json     // Structured diff: { before, after, proposedOperations }
  applied       Boolean  @default(false)
  createdAt     DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([version])
  @@map("plan_revisions")
}

model BudgetCategory {
  id                  String   @id @default(cuid())
  eventId             String
  name                String
  allocatedPercentage Decimal  @default(0.00) @db.Decimal(5, 2)
  allocatedAmount     Decimal  @default(0.00) @db.Decimal(12, 2)
  estimatedAmount     Decimal  @default(0.00) @db.Decimal(12, 2)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  event    Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  expenses Expense[]

  @@index([eventId])
  @@map("budget_categories")
}

model Expense {
  id               String        @id @default(cuid())
  budgetCategoryId String
  name             String
  amount           Decimal       @db.Decimal(12, 2)
  dateIncurred     DateTime      @default(now())
  paymentStatus    PaymentStatus @default(PENDING)
  notes            String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  budgetCategory BudgetCategory @relation(fields: [budgetCategoryId], references: [id], onDelete: Cascade)

  @@index([budgetCategoryId])
  @@map("expenses")
}

model Task {
  id           String       @id @default(cuid())
  eventId      String
  title        String
  description  String?      @db.Text
  phase        TaskPhase    @default(PLANNING)
  priority     TaskPriority @default(MEDIUM)
  status       TaskStatus   @default(TODO)
  dueDate      DateTime?
  completedAt  DateTime?
  order        Int          @default(0)
  assignedTo   String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  dependencies TaskDependency[] @relation("DependentTasks")
  prerequisites TaskDependency[] @relation("PrerequisiteTasks")

  @@index([eventId])
  @@index([status])
  @@index([phase])
  @@map("tasks")
}

model TaskDependency {
  id             String   @id @default(cuid())
  taskId         String   // The task that depends on another
  prerequisiteId String   // The prerequisite task that must be finished first
  createdAt      DateTime @default(now())

  task         Task @relation("DependentTasks", fields: [taskId], references: [id], onDelete: Cascade)
  prerequisite Task @relation("PrerequisiteTasks", fields: [prerequisiteId], references: [id], onDelete: Cascade)

  @@unique([taskId, prerequisiteId])
  @@index([taskId])
  @@index([prerequisiteId])
  @@map("task_dependencies")
}

model Vendor {
  id            String       @id @default(cuid())
  eventId       String
  categoryName  String
  companyName   String
  contactPerson String?
  email         String?
  phone         String?
  websiteUrl    String?
  status        VendorStatus @default(RESEARCHING)
  notes         String?      @db.Text
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  event  Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  quotes VendorQuote[]

  @@index([eventId])
  @@index([status])
  @@map("vendors")
}

model VendorQuote {
  id               String    @id @default(cuid())
  vendorId         String
  description      String?
  quotedAmount     Decimal   @db.Decimal(12, 2)
  currency         String    @default("USD")
  validUntil       DateTime?
  isSelected       Boolean   @default(false)
  quoteDocumentUrl String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@map("vendor_quotes")
}

model Guest {
  id                    String     @id @default(cuid())
  eventId               String
  fullName              String
  email                 String?
  rsvpStatus            RsvpStatus @default(INVITED)
  dietaryPreference     String?
  requiresAccessibility Boolean    @default(false)
  notes                 String?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([rsvpStatus])
  @@map("guests")
}
